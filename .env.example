# --- Discord ---
DISCORD_TOKEN=
# Optional: register commands to one guild (instant) instead of globally (can take a while).
DISCORD_GUILD_ID=
# Optional: channel that receives a public feed of queues / matches / results.
FEED_CHANNEL_ID=

# --- Data source (everything comes from the website) ---
SITE_URL=https://balatromp.com
# Sent as the User-Agent so the maintainers can identify (and contact) the bot.
CONTACT=your-discord-handle

# --- Tracking ---
QUEUE_ID=1
# Leaderboard scope. 0 = everyone on the leaderboard (cold players ride along for free).
TOP_N=100
# Hot = queuing, in game, or active in the last HOT_COOLDOWN_MINUTES (+ their opponents).
HOT_POLL_SECONDS=10
HOT_COOLDOWN_MINUTES=10
# Warm = top N, subscribed-to, or played a game in the last WARM_WINDOW_HOURS.
WARM_POLL_SECONDS=30
WARM_WINDOW_HOURS=2
LEADERBOARD_REFRESH_MINUTES=10
# Cancelled matches are never cleared on the site. A match still "in game" after this long is
# treated as over; learned from completed match durations once ~30 are seen (between 30 min and
# STALE_MATCH_HOURS), this is the starting value.
MATCH_TIMEOUT_MINUTES=90
STALE_MATCH_HOURS=3
STALE_QUEUE_HOURS=2

DB_PATH=./data/tracklatro.db
MAX_SUBSCRIPTIONS_PER_USER=25

# --- Matchmaking model (used for queue-time estimates) ---
# Mirrors the queue bot's matchmaking rules. Its settings aren't public; these are the live "Standard
# Ranked" values as shared in the BMP Discord (Oct 2026). Staff adjust the high instaqueue band to
# roughly the top 125 of the leaderboard, so update it if that moves.
# Starting search range: players within this MMR of each other can match right away.
MM_SEARCH_START=200
# Range growth per 2 s tick (the "+ f(time waiting)"). Leave empty to calibrate it from observed matches.
MM_SEARCH_INCREMENT=
# Instaqueue bands: players both inside one band match instantly. "none" disables.
MM_INSTAQUEUE=895-99999,0-400

# --- Stats ---
# Default time zone for "win rate by time of day" in /stats, for users who haven't set one with
# /timezone (IANA name, e.g. Europe/Brussels).
STATS_TIMEZONE=UTC

# --- Live updates ---
# Followed players that get a live push stream from the site (most followed first): their queue and
# match changes reach subscribers instantly instead of on the next poll. 0 turns these streams off.
LIVE_STREAMS=50
