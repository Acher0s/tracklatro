# --- Discord ---
DISCORD_TOKEN=
# Optional: register commands to one guild (instant) instead of globally (can take a while).
DISCORD_GUILD_ID=
# Optional: channel that receives a public feed of queues / matches / results.
FEED_CHANNEL_ID=

# --- Data sources ---
SITE_URL=https://balatromp.com
BOTLATRO_URL=http://balatro.virtualized.dev:4931
# Sent as the User-Agent so the maintainers can identify (and contact) the bot.
CONTACT=your-discord-handle

# --- Tracking ---
QUEUE_ID=1
# Leaderboard scope. 0 = everyone on the leaderboard (cold players ride along for free).
TOP_N=100
# Hot = queuing, in game, or active in the last HOT_COOLDOWN_MINUTES (+ their opponents).
HOT_POLL_SECONDS=10
HOT_COOLDOWN_MINUTES=10
# Warm = top N, subscribed-to, or played a game in the last WARM_WINDOW_HOURS.
WARM_POLL_SECONDS=30
WARM_WINDOW_HOURS=2
LEADERBOARD_REFRESH_MINUTES=10
# The site occasionally misses MATCH_COMPLETED webhooks, leaving players stuck "in game".
STALE_MATCH_HOURS=3
STALE_QUEUE_HOURS=2

DB_PATH=./data/tracklatro.db
MAX_SUBSCRIPTIONS_PER_USER=25

# --- Matchmaking model (used for queue-time estimates) ---
# Botlatro's real queue settings are behind its authenticated API; these default to Botlatro's
# built-in defaults. Ask the maintainers for the real "Standard Ranked" values if you can.
MM_SEARCH_START=0
# Range growth per 2 s tick. Leave empty to calibrate it from observed matches.
MM_SEARCH_INCREMENT=
# Instaqueue bands: players both inside one band match instantly. "none" disables.
MM_INSTAQUEUE=650-2000,0-450
